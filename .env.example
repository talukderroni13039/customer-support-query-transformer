# Copy to .env.dev / .env.uat and fill in. Both are gitignored. Placeholders only in this file.
APP_ENV=dev
LOG_LEVEL=DEBUG

# Rewrite
ANTHROPIC_API_KEY=your-key-here
# anthropic | none
REWRITE_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
LLM_MAX_TOKENS=300
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=10
MAX_HISTORY_MESSAGES=12
REWRITE_STRICT=false
REWRITE_CACHE_PATH=./data/cache/rewrites.json
LLM_CALL_BUDGET=500
LLM_BUDGET_PATH=./data/cache/llm_call_budget.json

# Embeddings + vector store
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=support_kb
CHUNK_MAX_CHARS=1200

# Hybrid + rerank
CANDIDATES_PER_RETRIEVER=20
RRF_K=60
RERANK_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_CANDIDATES=10
# Opt-in cut-off: reranked results scoring below this (0-1) are dropped. 0 = off (default).
# Measured on the benchmark: 0.01 also removes correct articles, so calibrate before enabling.
RERANK_MIN_SCORE=0

# Chat (POST /chat)
# Chunks whose rerank score is below this are not shown to Claude (calibrated, see docs/BENCHMARK.md)
CHAT_MIN_RERANK_SCORE=0.05
CHAT_CONTEXT_CHUNKS=5
LLM_ANSWER_MAX_TOKENS=900
# Correction attempts when an answer fails the grounding check
LLM_ANSWER_MAX_RETRIES=1
ANSWER_CACHE_PATH=./data/cache/answers.json

# General
# Set to 1 after both models are downloaded
HF_HUB_OFFLINE=0
KB_DIR=./data/kb
DEFAULT_TOP_K=3
